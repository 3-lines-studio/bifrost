{
  "shared": ["ui/ui.go", "public/ui/tokens.css", "public/ui/base.css"],
  "sharedBehavior": ["public/ui/ui.js"],
  "components": {
    "button": {
      "type": "primitive",
      "description": "Button with shadcn variants and sizes.",
      "files": ["ui/button.go", "public/ui/button.css"]
    },
    "label": {
      "type": "primitive",
      "description": "Label tied to a form control.",
      "files": ["ui/label.go", "public/ui/label.css"]
    },
    "input": {
      "type": "form",
      "description": "Text input with invalid and disabled states.",
      "files": ["ui/input.go", "public/ui/input.css"]
    },
    "textarea": {
      "type": "form",
      "description": "Textarea with invalid and disabled states.",
      "files": ["ui/textarea.go", "public/ui/textarea.css"]
    },
    "field": {
      "type": "primitive",
      "description": "Label, control, hint, and error helper.",
      "files": ["ui/field.go", "public/ui/field.css"],
      "deps": ["label", "input"]
    },
    "card": {
      "type": "primitive",
      "description": "Card anatomy and badge variants.",
      "files": ["ui/card.go", "public/ui/card.css"]
    },
    "badge": {
      "type": "primitive",
      "description": "Badge variants.",
      "files": ["ui/badge.go", "public/ui/badge.css"]
    },
    "alert": {
      "type": "primitive",
      "description": "Alert with title and description.",
      "files": ["ui/alert.go", "public/ui/alert.css"]
    },
    "avatar": {
      "type": "primitive",
      "description": "Avatar image and fallback.",
      "files": ["ui/avatar.go", "public/ui/avatar.css"]
    },
    "separator": {
      "type": "primitive",
      "description": "Horizontal and vertical separator.",
      "files": ["ui/separator.go", "public/ui/separator.css"]
    },
    "skeleton": {
      "type": "primitive",
      "description": "Loading skeleton.",
      "files": ["ui/skeleton.go", "public/ui/skeleton.css"]
    },
    "progress": {
      "type": "primitive",
      "description": "Progress bar.",
      "files": ["ui/progress.go", "public/ui/progress.css"]
    },
    "checkbox": {
      "type": "form",
      "description": "Native checkbox with shadcn slot.",
      "files": ["ui/checkbox.go", "public/ui/checkbox.css"]
    },
    "switch": {
      "type": "form",
      "description": "Native switch control.",
      "files": ["ui/switch.go", "public/ui/switch.css"]
    },
    "radio-group": {
      "type": "form",
      "description": "Radio group and radio item.",
      "files": ["ui/radio_group.go", "public/ui/radio-group.css"]
    },
    "table": {
      "type": "primitive",
      "description": "Table anatomy with header, body, footer, and cells.",
      "files": ["ui/table.go", "public/ui/table.css"]
    },
    "pagination": {
      "type": "primitive",
      "description": "Pagination navigation and links.",
      "files": ["ui/pagination.go", "public/ui/pagination.css"]
    },
    "dialog": {
      "type": "behavior",
      "description": "Composable native dialog with Alpine state.",
      "files": ["ui/dialog.go", "public/ui/dialog.css"],
      "behavior": true
    },
    "dropdown-menu": {
      "type": "behavior",
      "description": "Composable dropdown menu with keyboard navigation.",
      "files": ["ui/dropdown_menu.go", "public/ui/dropdown-menu.css"],
      "behavior": true
    },
    "tabs": {
      "type": "behavior",
      "description": "Composable tabs with arrow-key navigation.",
      "files": ["ui/tabs.go", "public/ui/tabs.css"],
      "behavior": true
    },
    "toast": {
      "type": "behavior",
      "description": "Toast region backed by an Alpine store.",
      "files": ["ui/toast.go", "public/ui/toast.css"],
      "behavior": true
    },
    "pricing": {
      "type": "block",
      "description": "Pricing block built from primitives and tokens.",
      "files": ["ui/pricing.go", "public/ui/pricing.css"],
      "deps": ["button"],
      "behavior": false
    }
  }
}
